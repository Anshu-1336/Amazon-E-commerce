*{
    margin:0;
    font-family: arial;
    border: border-box;
}
.navar{
height:60px;
background-color:#000000;
display: flex;
align-items: center;
justify-content: space-evenly;
}
.nav-logo {
    height:50px;
    width: 120px;
}
.logo {

    background-image: url("IMG-20240427-WA0011.jpg");
    background-size: cover;
    height: 50px;
    width: 100%;
}
.border {
    border: 2px solid transparent;
}
.border:hover {
    border: 2px solid white;
}

.add-icon {
    display: flex;
    align-items: center;
}

.first
{
 color: #dcd5d5;
 margin-left: 10px;
}

.second {
    color: rgb(221, 226, 231);
}
.add-icon {
color: rgb(203, 148, 66);
}

.nav-search {
    display: flex;
    justify-content: space-evenly;
    width: 350px;
    height: 30px;
    border-radius: 6px;
    border: none;
}
.nav-search:hover
{
    border: 2px solid orange;
}
.search-select {
    background-color: white;
    width: 45px;
    height: 30px;
    text-align: center;
    border-top-left-radius:5px;
    border-bottom-left-radius:5px ;
    border: none;
}
.search-input {
    text-align: center;
    width: 350px;
    font-size: 1rem;
    
}
.search-icon {
    justify-content: center; /* to horizontal centre */
    display: flex;
    width: 45px;
    background-color: #febd68;
    align-items: center;  /* to vertical centre */
    border-top-right-radius: 5px ;
    border-bottom-right-radius: 5px;
    border: none;
}
.nav-sign{
    color: white;
}
span {
    font-size: 0.8rem;
}
.nav-account {
    font-size: 0.95;
    font-weight: 500;
}
.nav-return{
    color: white;
}
span{
    font-size: 0.8rem;
} 
.nav-order {
    font-size: 0.95;
    font-weight: 500;
}
.nav-cart i{
    font-size: 25px;
}
.nav-cart {
    color: white;
    font-size: 0.95rem;
    display:flex
    font-weight:500;
}
.panel {
    color: white;
    height: 35px;
    background-color: #222f3d;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
}
.panel-ops p {
    display: inline;
    width: 80%;
    margin-left: 20px;
    font-size: 0.8rem;

}
.panel-ops{
    width: 80%;
    font-size: 0.85rem;
}
.panel-deals {
    font-size: 1rem;
    font-weight: 500;
}


.hero-sec {
    background-size: cover;
    background-image: url("IMG-20240427-WA0023.jpg");
    height:400px;
    display: flex;
    align-items: flex-end;
    justify-content: center;

}

.hero-msg {
    background-color: white;
    color: black;
    height:35px;
    display: flex;
    align-items: center; /* horizontal centre*/
    justify-content: center;
    font-size: 0.95rem;
    bottom: 25px;
    position: relative;
    width: 80%;
    margin-bottom: 2px;
}
.hero-msg a {
    color: #007185;
}
.shop-section {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    background-color: #2d3b4b;
}
.box{
    margin-top:15px;
    height: 340px;
    width: 23%;
    background-color: white;
    padding: 20px 0px 15px;
}
.box-image {
    height: 260px;
    background-size: cover;
    margin-top: 1rem;
    margin-bottom: 1rem;

  
}
.box-content {
    margin-left:10px;
    margin-right: 10px;
}
.box-content p {
    color: #007185;

}
